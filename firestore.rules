rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function correoAdminVerificado() {
      return autenticado()
        && request.auth.token.email == "christianandrango23.24@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function rolPermitido(rol) {
      return (rol == "admin" && correoAdminVerificado())
        || (rol == "maestro"
          && request.auth.token.email is string
          && request.auth.token.email.matches("^[^@]+@tesa[.]edu[.]ec$"))
        || (rol == "estudiante"
          && request.auth.token.email is string
          && request.auth.token.email.matches("^[^@]+@estud[.]tesa[.]edu[.]ec$"));
    }

    function maestro() {
      return correoAdminVerificado()
        || (autenticado()
          && request.auth.token.email is string
          && request.auth.token.email.matches("^[^@]+@tesa[.]edu[.]ec$"));
    }

    function docente() {
      return autenticado()
        && request.auth.token.email is string
        && request.auth.token.email.matches("^[^@]+@tesa[.]edu[.]ec$");
    }

    function estudiante() {
      return autenticado()
        && request.auth.token.email is string
        && request.auth.token.email.matches("^[^@]+@estud[.]tesa[.]edu[.]ec$");
    }

    function supervisionDelDocente(sesionId) {
      return docente()
        && exists(/databases/$(database)/documents/supervisionesEnVivo/$(sesionId))
        && get(/databases/$(database)/documents/supervisionesEnVivo/$(sesionId)).data.maestroUid == request.auth.uid;
    }

    function supervisionDelEstudiante(sesionId) {
      return estudiante()
        && exists(/databases/$(database)/documents/supervisionesEnVivo/$(sesionId))
        && get(/databases/$(database)/documents/supervisionesEnVivo/$(sesionId)).data.estudianteUid == request.auth.uid;
    }

    function administrador() {
      return correoAdminVerificado();
    }

    function perfilValido() {
      return (!request.resource.data.keys().hasAny(["nombreCompleto"])
          || (request.resource.data.nombreCompleto is string && request.resource.data.nombreCompleto.size() <= 120))
        && (!request.resource.data.keys().hasAny(["fotoPerfil"])
          || (request.resource.data.fotoPerfil is string
            && request.resource.data.fotoPerfil.size() <= 150000
            && request.resource.data.fotoPerfil.matches("data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+")));
    }

    match /usuarios/{uid} {
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.correo == request.auth.token.email
        && rolPermitido(request.resource.data.rol)
        && request.resource.data.keys().hasOnly([
          "correo", "rol", "primerAcceso", "ultimoAcceso", "enLinea", "cantidadAccesos", "nombreCompleto", "fotoPerfil"
        ])
        && perfilValido();
      allow update: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.correo == resource.data.correo
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "ultimoAcceso", "enLinea", "cantidadAccesos", "ultimaActividad", "nombreCompleto", "fotoPerfil"
        ])
        && perfilValido()
        || (correoAdminVerificado()
          && request.auth.uid == uid
          && request.resource.data.correo == request.auth.token.email
          && request.resource.data.rol == "admin"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "rol", "ultimoAcceso", "enLinea", "cantidadAccesos", "ultimaActividad", "nombreCompleto", "fotoPerfil"
          ])
          && perfilValido());
      allow read: if administrador() || maestro() || (autenticado() && request.auth.uid == uid);
    }

    match /usuariosPendientes/{correo} {
      allow read, write: if administrador();
    }

    match /examenes/{examenId} {
      allow read: if autenticado();
      allow create: if maestro() && (request.resource.data.maestroUid == request.auth.uid || administrador());
      allow update: if administrador()
        || (maestro()
          && (resource.data.maestroUid == request.auth.uid
            || (!resource.data.keys().hasAny(["maestroUid"]) && request.resource.data.maestroUid == request.auth.uid))
          && request.resource.data.maestroUid == request.auth.uid);
      allow delete: if administrador() || (maestro() && resource.data.maestroUid == request.auth.uid);
    }

    match /resultados/{resultadoId} {
      allow create: if estudiante()
        && request.resource.data.keys().hasOnly([
          "estudianteUid", "estudianteCorreo", "nombreCompleto", "maestroUid", "maestroCorreo",
          "examenId", "examenNombre", "formato", "respuestasCorrectas", "totalPreguntas",
          "calificacion", "respuestas", "respuestasDetalle", "cambiosPestana", "movimientosCamara",
          "eventosSupervision", "eventosOmitidos", "fechaInicio", "duracionSegundos", "motivoEntrega",
          "estado", "fechaEntrega"
        ])
        && request.resource.data.estudianteUid == request.auth.uid
        && request.resource.data.estudianteCorreo == request.auth.token.email
        && request.resource.data.nombreCompleto
          == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nombreCompleto
        && request.resource.data.examenId is string
        && exists(/databases/$(database)/documents/examenes/$(request.resource.data.examenId))
        && request.resource.data.maestroUid == get(/databases/$(database)/documents/examenes/$(request.resource.data.examenId)).data.maestroUid
        && request.resource.data.respuestas is list
        && request.resource.data.respuestasDetalle is list
        && request.resource.data.totalPreguntas is int
        && request.resource.data.totalPreguntas > 0
        && request.resource.data.respuestas.size() == request.resource.data.totalPreguntas
        && request.resource.data.respuestasDetalle.size() == request.resource.data.totalPreguntas
        && request.resource.data.respuestasCorrectas is int
        && request.resource.data.respuestasCorrectas >= 0
        && request.resource.data.respuestasCorrectas <= request.resource.data.totalPreguntas
        && (request.resource.data.motivoEntrega != "entrega_manual"
          || !request.resource.data.respuestas.hasAny([""]))
        && request.resource.data.eventosSupervision is list
        && request.resource.data.eventosOmitidos is int
        && request.resource.data.duracionSegundos is int
        && request.resource.data.duracionSegundos >= 0
        && request.resource.data.fechaInicio is timestamp
        && request.resource.data.motivoEntrega in ["entrega_manual", "tiempo_agotado", "bloqueada_por_cambios"]
        && request.resource.data.fechaEntrega == request.time;
      allow read: if administrador()
        || (maestro() && resource.data.maestroUid == request.auth.uid)
        || (autenticado() && resource.data.estudianteUid == request.auth.uid);
      allow update: if administrador()
        || (maestro()
          && resource.data.maestroUid == request.auth.uid
          && resource.data.estado == "pendiente"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "calificacionesComplexivas", "calificacion", "estado", "calificadaPorUid", "fechaCalificacion"
          ])
          && request.resource.data.calificacionesComplexivas is list
          && request.resource.data.calificacion is number
          && request.resource.data.calificacion >= 0
          && request.resource.data.calificacion <= 10
          && request.resource.data.estado == "calificada"
          && request.resource.data.calificadaPorUid == request.auth.uid
          && request.resource.data.fechaCalificacion == request.time);
    }

    match /supervisionesEnVivo/{sesionId} {
      allow create: if estudiante()
        && request.resource.data.keys().hasOnly([
          "examenId", "examenNombre", "estudianteUid", "estudianteNombre",
          "maestroUid", "estado", "actualizadoEn"
        ])
        && request.resource.data.examenId is string
        && request.resource.data.examenNombre is string
        && request.resource.data.examenNombre.size() <= 120
        && request.resource.data.estudianteUid == request.auth.uid
        && request.resource.data.estudianteNombre is string
        && request.resource.data.estudianteNombre.size() <= 120
        && request.resource.data.maestroUid is string
        && request.resource.data.estado == "activa"
        && request.resource.data.actualizadoEn == request.time
        && exists(/databases/$(database)/documents/examenes/$(request.resource.data.examenId))
        && get(/databases/$(database)/documents/examenes/$(request.resource.data.examenId)).data.maestroUid
          == request.resource.data.maestroUid;
      allow read: if (docente() && resource.data.maestroUid == request.auth.uid)
        || (estudiante() && resource.data.estudianteUid == request.auth.uid);
      allow update: if supervisionDelEstudiante(sesionId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado", "actualizadoEn"])
        && request.resource.data.estado in ["activa", "finalizada"]
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if supervisionDelEstudiante(sesionId);

      match /ofertas/{ofertaId} {
        allow get: if supervisionDelEstudiante(sesionId);
        allow create, update: if supervisionDelDocente(sesionId)
          && ofertaId == "maestro"
          && request.resource.data.keys().hasOnly(["ofertaId", "sdp", "actualizadoEn"])
          && request.resource.data.ofertaId is string
          && request.resource.data.ofertaId.size() <= 100
          && request.resource.data.sdp is string
          && request.resource.data.sdp.size() <= 120000
          && request.resource.data.actualizadoEn == request.time;
        allow delete: if supervisionDelDocente(sesionId) || supervisionDelEstudiante(sesionId);
      }

      match /respuestas/{respuestaId} {
        allow get: if supervisionDelDocente(sesionId) || supervisionDelEstudiante(sesionId);
        allow create, update: if supervisionDelEstudiante(sesionId)
          && respuestaId == "estudiante"
          && request.resource.data.keys().hasOnly(["ofertaId", "sdp", "actualizadoEn"])
          && request.resource.data.ofertaId is string
          && request.resource.data.ofertaId.size() <= 100
          && request.resource.data.sdp is string
          && request.resource.data.sdp.size() <= 120000
          && request.resource.data.actualizadoEn == request.time;
        allow delete: if supervisionDelDocente(sesionId) || supervisionDelEstudiante(sesionId);
      }
    }

    // ---------- Clases: el administrador asigna asignaturas a cada maestro ----------
    match /clases/{claseId} {
      allow read: if autenticado();
      allow create, update, delete: if administrador();
    }

    // ---------- Asistencia: un registro por persona y por día, solo se crea ----------
    match /asistencias/{asistenciaId} {
      allow read: if administrador() || maestro()
        || (autenticado() && asistenciaId.matches(request.auth.uid + "_.*"));
      allow create: if autenticado()
        && asistenciaId == request.auth.uid + "_" + request.resource.data.dia
        && request.resource.data.keys().hasOnly(["uid", "correo", "nombre", "rol", "dia", "fecha"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.dia is string && request.resource.data.dia.size() == 10
        && request.resource.data.rol in ["admin", "maestro", "estudiante"]
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 120
        && request.resource.data.fecha == request.time;
      allow update, delete: if false;
    }

    // ---------- Papelera: exámenes eliminados (se conservan 30 días) ----------
    match /papelera/{itemId} {
      allow create: if maestro() && request.resource.data.eliminadoPorUid == request.auth.uid;
      allow read, delete: if administrador()
        || (maestro() && resource.data.eliminadoPorUid == request.auth.uid);
      allow update: if false;
    }
  }
}
